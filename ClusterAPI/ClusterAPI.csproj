    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProductService\ClusterService\BLL\BLL.csproj" />
    <ProjectReference Include="..\ProductService\ClusterService\DAL\DAL.csproj" />
    <ProjectReference Include="..\ProductService\ClusterService\Domain\Domain.csproj" />
    <ProjectReference Include="..\ProductService\SupperDto\SupperBackEndDto\SupperBackEndDto.csproj" />
  </ItemGroup>

</Project>
