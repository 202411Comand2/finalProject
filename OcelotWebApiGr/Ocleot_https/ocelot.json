  "GlobalConfiguration": {
    "BaseUrl": "https://your-gateway-domain.com",
    "CorsPolicy": {
      "AllowedOrigins": [ "https://your-frontend.com", "http://localhost:3000" ],
      "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
